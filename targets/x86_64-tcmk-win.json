{
  "llvm-target": "x86_64-unknown-windows-gnu",
  "data-layout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
  "arch": "x86_64",
  "target-endian": "little",
  "target-pointer-width": 64,
  "target-c-int-width": 32,
  "os": "windows",
  "env": "msvc",
  "vendor": "pc",
  "executables": true,
  "binary-format": "coff",
  "archive-format": "coff",
  "is-like-windows": true,
  "is-like-msvc": true,
  "linker": "rust-lld",
  "linker-flavor": "msvc-lld",
  "lld-flavor": "link",
  "linker-is-gnu": false,
  "crt-objects-fallback": "false",
  "emit-debug-gdb-scripts": false,
  "dll-tls-export": false,
  "pre-link-args": {
    "msvc-lld": [
      "/NOLOGO",
      "/entry:_start",
      "/subsystem:console",
      "/base:0x140000000",
      "/fixed:no",
      "/nodefaultlib"
    ]
  },
  "panic-strategy": "abort",
  "disable-redzone": true,
  "features": "-mmx,-sse,-sse2,+soft-float",
  "rustc-abi": "softfloat",
  "singlethread": true,
  "max-atomic-width": 64
}
